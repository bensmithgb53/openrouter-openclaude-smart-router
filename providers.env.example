# Copy this file to ~/.smart-free-router/providers.env and fill only the keys you own.
# Keep the real file outside the repository and chmod 600.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
# DeepSeek is optional and may require paid credits.
DEEPSEEK_API_KEY=

# Optional comma-separated model overrides, for example:
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# GROQ_MODELS=llama-4-scout-17b-16e-instruct,qwen/qwen3-32b
# CEREBRAS_MODELS=qwen-3.8-27b
